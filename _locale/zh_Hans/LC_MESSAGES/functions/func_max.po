#: ../../functions/func_max.rst:6
msgid "$max"
msgstr ""

#: ../../functions/func_max.rst:8
msgid "Usage: **$max(type,x,...)**"
msgstr "用法：**$max(type,x,...)**"

#: ../../functions/func_max.rst:9
msgid "Category: information"
msgstr "类别：信息"

#: ../../functions/func_max.rst:10
msgid "Implemented: Picard 2.9"
msgstr "实现版本：Picard 2.9"

#: ../../functions/func_max.rst:12
msgid "**Description:**"
msgstr "**描述：**"

#: ../../functions/func_max.rst:14
msgid "Returns the maximum value using the comparison specified in ``type``."
msgstr "使用 ``type`` 中指定的比较方式返回最大值。"

#: ../../functions/func_max.rst:16
msgid "Possible values of ``type`` are \"int\" (integer), \"float\" (floating point), \"text\" (case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" (automatically determine the type of arguments provided), with \"auto\" used as the default comparison method if ``type`` is not specified. The \"auto\" type will use the first type that applies to both arguments in the following order of preference: \"int\", \"float\" and \"text\"."
msgstr ""
"``type`` 的可能值为 \"int\"（整数）、\"float\"（浮点数）、\"text\"（区分大小"
"写的文本）、\"nocase\"（不区分大小写的文本）和 \"auto\"（自动确定提供的参数类"
"型），如果未指定 ``type``，则使用 \"auto\" 作为默认比较方法。\n"
"\"auto\" 类型将按以下优先顺序使用适用于两个参数的第一个类型"
"：\"int\"、\"float\" 和 \"text\"。"

#: ../../functions/func_max.rst:18
msgid "Can be used with an arbitrary number of arguments. Multi-value arguments will be expanded automatically."
msgstr "可以接受任意数量的参数。多值参数将自动展开。"

#: ../../functions/func_max.rst:21
msgid "**Example:**"
msgstr "**示例：**"

#: ../../functions/func_max.rst:23
msgid "The following statements will return the values indicated:"
msgstr "以下语句将返回指示的值："

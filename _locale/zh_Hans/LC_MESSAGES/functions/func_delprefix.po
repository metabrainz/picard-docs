#: ../../functions/func_delprefix.rst:6
msgid "$delprefix"
msgstr ""

#: ../../functions/func_delprefix.rst:8
msgid "Usage: **$delprefix(text[,prefixes])**"
msgstr "用法：**$delprefix(text[,prefixes])**"

#: ../../functions/func_delprefix.rst:9
msgid "Category: text"
msgstr "类别：文本"

#: ../../functions/func_delprefix.rst:10
msgid "Implemented: Picard 1.3"
msgstr "实现：Picard 1.3"

#: ../../functions/func_delprefix.rst:12
msgid "**Description:**"
msgstr "**描述：**"

#: ../../functions/func_delprefix.rst:14
msgid "Deletes the specified ``prefixes`` from the beginning of ``text``. Any number of ``prefixes`` can be specified, separated by commas. If no prefix is specified \"A\" and \"The\" are used by default. Note that the matching is case-sensitive."
msgstr ""
"从 ``text`` 的开头删除指定的 ``prefixes``。可以指定任意数量的 ``prefixes``，"
"用逗号分隔。如果没有指定前缀，默认使用 \"A\" 和 \"The\"。请注意，匹配是区分大"
"小写的。"


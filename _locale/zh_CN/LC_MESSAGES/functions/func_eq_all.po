#: ../../functions/func_eq_all.rst:6
msgid "$eq_all"
msgstr ""

#: ../../functions/func_eq_all.rst:8
msgid "Usage: **$eq_all(x,a1,a2,\\*args)**"
msgstr "用法：**$eq_all(x,a1,a2,\\*args)**"

#: ../../functions/func_eq_all.rst:9
msgid "Category: conditional"
msgstr "类别：条件"

#: ../../functions/func_eq_all.rst:11
msgid "**Description:**"
msgstr "**描述：**"

#: ../../functions/func_eq_all.rst:13
msgid "Returns true if ``x`` equals ``a1`` and ``a2``, etc. Can be used with an arbitrary number of arguments. Note that comparisons are case-sensitive."
msgstr ""
"如果 ``x`` 等于 ``a1`` 和 ``a2`` 等等，则返回 true。可以与任意数量的参数一起"
"使用。请注意，比较是区分大小写的。"

#: ../../functions/func_eq_all.rst:15
msgid "Functionally equivalent to ``$and($eq(x,a1),$eq(x,a2) ...)``."
msgstr "功能上等效于 ``$and($eq(x,a1),$eq(x,a2) ...)``。"

#: ../../functions/func_eq_all.rst:21
msgid "Formatting the code using characters such as spaces, tabs or newlines can affect the result of the function."
msgstr "使用空格、制表符或换行符等字符格式化代码可能会影响函数的结果。"

#: ../../functions/func_eq_all.rst:23
msgid "**Example:**"
msgstr "**示例：**"

#: ../../functions/func_eq_all.rst:25
msgid "The following statements will return the values indicated:"
msgstr "以下语句将返回指示的值："

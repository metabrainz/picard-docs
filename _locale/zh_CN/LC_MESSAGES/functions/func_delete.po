#: ../../functions/func_delete.rst:6
msgid "$delete"
msgstr ""

#: ../../functions/func_delete.rst:8
msgid "Usage: **$delete(name)**"
msgstr "用法：**$delete(name)**"

#: ../../functions/func_delete.rst:9
msgid "Category: assignment"
msgstr "类别：赋值"

#: ../../functions/func_delete.rst:10
msgid "Implemented: Picard 2.1"
msgstr "实现：Picard 2.1"

#: ../../functions/func_delete.rst:12
msgid "**Description:**"
msgstr "**描述：**"

#: ../../functions/func_delete.rst:14
msgid "Unsets the variable ``name`` and marks the tag for deletion."
msgstr "清除变量 ``name`` 并将标签标记为删除。"

#: ../../functions/func_delete.rst:16
msgid "This is similar to ``$unset(name)`` but also marks the tag for deletion. For example, running ``$delete(genre)`` will actually remove the \"genre\" tag from a file when saving."
msgstr ""
"这与 ``$unset(name)`` 类似，但也会将标签标记为删除。例如，在保存时运行 "
"``$delete(genre)`` 实际上会从文件中删除 \"genre\" 标签。"


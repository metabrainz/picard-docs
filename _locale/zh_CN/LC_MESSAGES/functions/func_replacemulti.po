#: ../../functions/func_replacemulti.rst:6
msgid "$replacemulti"
msgstr ""

#: ../../functions/func_replacemulti.rst:8
msgid "Usage: **$replacemulti(name,search,replace[,separator])**"
msgstr "用法：**$replacemulti(name,search,replace[,separator])**"

#: ../../functions/func_replacemulti.rst:9
msgid "Category: multi-value"
msgstr "类别：多值"

#: ../../functions/func_replacemulti.rst:10
msgid "Implemented: Picard 2.6.1"
msgstr "实现：Picard 2.6.1"

#: ../../functions/func_replacemulti.rst:12
msgid "**Description:**"
msgstr "**描述：**"

#: ../../functions/func_replacemulti.rst:14
msgid "Replaces occurrences of ``search`` with ``replace`` in the multi-value variable ``name`` and returns the resulting multi-value variable string with the elements separated by ``separator`` (or the default separator of a semicolon followed by a space \"; \" if not passed)."
msgstr ""
"将多值变量 ``name`` 中的 ``search`` 出现替换为 ``replace`` ，并以 "
"``separator`` （或默认的分号加空格 \"; \"，如果未传递）分隔返回结果的多值变量"
"字符串。"

#: ../../functions/func_replacemulti.rst:16
msgid "Empty elements are automatically removed from the output."
msgstr "输出中会自动移除空元素。"

#: ../../functions/func_replacemulti.rst:18
msgid "**Example:**"
msgstr "**示例：**"

#: ../../functions/func_replacemulti.rst:20
msgid "The following statements will return the values indicated:"
msgstr "以下语句将返回指示的值："

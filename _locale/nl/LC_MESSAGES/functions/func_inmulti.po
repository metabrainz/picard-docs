msgid "Usage: **$inmulti(multi,value[,separator])**"
msgstr "Gebruik: **$inmulti(%x%,y)**"

#: ../../functions/func_inmulti.rst:9
msgid "Category: conditional"
msgstr "Categorie: voorwaardelijk"

#: ../../functions/func_inmulti.rst:10

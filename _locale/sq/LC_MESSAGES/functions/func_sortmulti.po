#: ../../functions/func_sortmulti.rst:6
msgid "$sortmulti"
msgstr ""

#: ../../functions/func_sortmulti.rst:8
msgid "Usage: **$sortmulti(multi[,separator])**"
msgstr ""

#: ../../functions/func_sortmulti.rst:9
msgid "Category: multi-value"
msgstr ""

#: ../../functions/func_sortmulti.rst:10
msgid "Implemented: Picard 2.3.1"
msgstr ""

#: ../../functions/func_sortmulti.rst:12
msgid "**Description:**"
msgstr ""

#: ../../functions/func_sortmulti.rst:14
msgid ""
"Returns a copy of the multi-value variable ``multi`` with the elements "
"sorted in ascending order. A literal value representing a multi-value can be "
"substituted for ``multi``, using the ``separator`` (or a semicolon followed "
"by a space \"; \" if not passed) to coerce the value into a proper multi-"
"valued variable. If ``multi`` is missing ``$sortmulti`` will return an empty "
"string."
msgstr ""

